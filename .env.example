# Copy to .env and fill locally. Never commit the populated .env file.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=ady-raw
# For the host Python CLI; Docker Compose overrides the endpoint inside app.
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
# Set only if starting the optional RStudio analysis profile.
RSTUDIO_PASSWORD=
